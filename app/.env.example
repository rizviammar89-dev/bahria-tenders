# Copy to app/.env.local (gitignored) and fill from `supabase status`.
# Web / Android emulator can use localhost; a PHYSICAL device must use the dev
# machine's LAN IP (e.g. http://172.21.16.1:54321) — localhost on a phone = the phone itself.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-status
